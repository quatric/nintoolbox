const rel_info_t *GetInfoREL (str_mode_t mode)
{
	rel_info_t *ri;
	switch (mode)
	{
		case STR_M_PAL:
			ri = &rel_info_pal;
			break;
		case STR_M_USA:
			ri = &rel_info_usa;
			break;
		case STR_M_JAP:
			ri = &rel_info_jap;
			break;
		case STR_M_KOR:
			ri = &rel_info_kor;
			break;
		default:
			return 0;
	}

	DASSERT (ri);
	if (!ri->sect[0].addr)
	{
		for (dol_sect_info_t *ptr = ri->sect; ptr->section >= 0; ptr++)
		{
			ptr->size = ptr[1].off - ptr->off;
			ptr->addr = ri->load_addr + ptr->off;
		}
	}
	return ri;
}

