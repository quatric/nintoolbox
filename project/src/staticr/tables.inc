static char *GetIdPointer (const staticr_t *str)
{
	const u32 addr = GetIdAddress (str);
	if (addr)
	{
		const dol_header_t *dol_head = (dol_header_t *)str->data;
		const u32 off = GetDolOffsetByAddr (dol_head, addr, PATCHED_BY_SIZE, 0);
