// Header flag 0x200 marks an encrypted body (only IF/ECATCH/gameinfo.bin): main.dol FUN_8000e684 runs FUN_8000e39c over the
// u32 size bytes after the header and clears the flag. Each byte goes through table i % 3, then from the end down to byte 1
// b[i] -= b[i - 1] + key + i (mod 256); the GameInfo loader (FUN_800d9ed8) passes key 0x7f.
static void sega_ghsl_decrypt (u8 *p, size_t n, u8 key)
{
	for (size_t i = 0; i < n; i++)
		p[i] = sega_ghsl_sbox[i % 3 * 256 + p[i]];
	for (size_t i = n - 1; n && i > 0; i--)
		p[i] -= (u8)(p[i - 1] + key + i);
}

static enumError extract_sega_ghsl_file (ccp arg, ccp basedir, uint depth)
{
	(void)depth;
	if (!is_ext (arg, ".bin"))
		return ERR_NOTHING_TO_DO;
	u8 *c = 0;
	size_t cs = 0;
	if (LoadFileAlloc (arg, 0, 0, &c, &cs, 0, 0, 0, false) || !c || cs < 0x20 || memcmp (c, "GHSL", 4) || rd_le32 (c + 8) != 0x10 || (rd_le32 (c + 0xc) & ~0x200u)
		|| (rd_le32 (c + 0xc) && rd_le32 (c + 4) > cs - 0x10))
	{
		FREE (c);
		return ERR_NOTHING_TO_DO;
	}
	if (rd_le32 (c + 0xc))
		sega_ghsl_decrypt (c + 0x10, rd_le32 (c + 4), 0x7f);
	sumo_buf_t b = { 0, 0, 0, true };
	sega_ghsl_t g = { c, cs, 0, 0, &b, true };
	const u64 tab = 0x10 + (u64)rd_le32 (c + 0x10);
	if (tab + 4 > cs)
		g.ok = false;
	else
	{
		g.tab = tab;
		g.ntab = rd_le32 (c + tab);
		if (g.ntab > 0x1000000 || tab + 4 + 4ull * g.ntab > cs)
			g.ok = false;
	}
	if (g.ok)
	{
		sumo_printf (&b, "{\"format\": \"Sakura Wars GHSL\", \"tree\": ");
		ghsl_node (&g, 0x14, 0);
		sumo_printf (&b, "}\n");
	}
	enumError err = ERR_NOTHING_TO_DO;
	if (g.ok && b.ok && b.n && b.n < 0xffffffffu)
	{
		char dest[PATH_MAX], name[PATH_MAX];
		beside_source_dest (dest, sizeof (dest), arg);
		const char *sl = strrchr (arg, '/');
		snprintf (name, sizeof (name), "%s", sl ? sl + 1 : arg);
		char *dot = strrchr (name, '.');
		if (dot)
			strcpy (dot, ".json");
		if (verbose >= 0 || testmode)
			fprintf (stdlog, "%s%sEXTRACT SEGA-GHSL:%s -> %s/%s\n", verbose > 0 ? "\n" : "", testmode ? "WOULD " : "", arg, dest, name);
		err = shade_write (arg, dest, basedir, name, (u8 *)b.p, (uint)b.n);
	}
	FREE (b.p);
	FREE (c);
	return err;
}
