
# optimize mac binaries and/or build universal binaries

CFLAGS += -Wno-gnu-variable-sized-type-not-at-end -Wno-address-of-packed-member

# Minimum OS versions for each slice. Keep the historical local-build
# defaults, but let CI/distributors raise them to match their dependency
# binaries. In particular, a Homebrew bottle built for macOS 14 cannot be
# linked into a slice claiming compatibility with macOS 10.12.
MACOS_X86_64_TARGET ?= 10.12
MACOS_ARM64_TARGET  ?= 11

#-----------------------------------------------------------------------------

.PHONY : mac-distrib
mac-distrib: mac1x doc $(INSTALL_SCRIPTS) gen-mac-distrib

.PHONY : mac1x
mac1x: mac-x86_64

	@echo
	@echo "----- building universal binaries -----"

	@for i in $(ALL_TOOLS); do \
	    [ -f bin/x86_64/$${i} ] || { echo "skip $${i} (no x86_64 half)"; continue; }; \
	    lipo -create bin/x86_64/$${i} -output $${i}; \
	    cp -p $${i} bin/$${i}; \
	done
	@rm -rf bin/x86_64
	@echo "done"

.PHONY : mac1
mac1: mac-arm

	@echo
	@echo "----- building universal binaries -----"

	@for i in $(ALL_TOOLS); do \
	    lipo -create bin/arm/$${i} -output $${i}; \
	    cp -p $${i} bin/$${i}; \
	done
	@rm -rf bin/arm
	@echo "done"

.PHONY : mac2
mac2: MACOS_X86_64_TARGET = 14.0
mac2: MACOS_ARM64_TARGET = 14.0
mac2:
# Both architecture legs share the source/object tree and each begins with a
# clean. Run the legs sequentially even when the outer make has -j enabled;
# each recursive all build still inherits the jobserver and compiles in
# parallel internally.
	@$(MAKE) --no-print-directory MACOS_X86_64_TARGET=$(MACOS_X86_64_TARGET) mac-x86_64
	@$(MAKE) --no-print-directory MACOS_ARM64_TARGET=$(MACOS_ARM64_TARGET) mac-arm

	@echo
	@echo "----- building universal binaries -----"

	@for i in $(ALL_TOOLS); do \
	    if [ -f bin/x86_64/$${i} ]; then \
	        lipo -create bin/x86_64/$${i} bin/arm/$${i} -output $${i}; \
	    else \
	        echo "no x86_64 half for $${i}, shipping arm64-only"; \
	        cp -p bin/arm/$${i} $${i}; \
	    fi; \
	    cp -p $${i} bin/$${i}; \
	done
	@rm -rf bin/x86_64 bin/arm
	@echo "done"

#-----------------------------------------------------------------------------

.PHONY : mac-ppc
mac-ppc:
	@echo
	@echo "----- building PowerPC [SDK $(SDKVERSION)] -----"
	@XFLAGS="-arch ppc -mcpu=powerpc" $(MAKE) --no-print-directory clean
	@XFLAGS="-arch ppc -mcpu=powerpc" $(MAKE) --no-print-directory all
	@mkdir -p bin/ppc
	@mv $(ALL_TOOLS) bin/ppc

#-----------------------------------------------------------------------------

.PHONY : mac-i386
mac-i386:
	@echo
	@echo "----- building i386 [SDK $(SDKVERSION)] -----"
	@XFLAGS="-arch i386 -mfpmath=sse -march=prescott" $(MAKE) --no-print-directory clean
	@XFLAGS="-arch i386 -mfpmath=sse -march=prescott" $(MAKE) --no-print-directory all
	@mkdir -p bin/i386
	@mv $(ALL_TOOLS) bin/i386


#-----------------------------------------------------------------------------

.PHONY : mac-x86_64
mac-x86_64:
	@echo
	@echo "----- building X86-64 [SDK $(SDKVERSION)] -----"
#	@XFLAGS="-arch x86_64 -mfpmath=sse" make clean all
# HOMEBREW_PREFIX=/usr/local: cross-compiling x86_64 on an arm64 host must
# not resolve libpng against the native arm64 Homebrew at /opt/homebrew
# (the default search path finds it first and the link fails with "not
# found for architecture x86_64"). /usr/local is where a Rosetta-run
# `brew install` puts real x86_64 slices.
	@HOMEBREW_PREFIX=/usr/local XFLAGS="-target x86_64-apple-macos$(MACOS_X86_64_TARGET)" $(MAKE) --no-print-directory clean
	@HOMEBREW_PREFIX=/usr/local XFLAGS="-target x86_64-apple-macos$(MACOS_X86_64_TARGET)" $(MAKE) --no-print-directory all
	@mkdir -p bin/x86_64
	@mv $(ALL_TOOLS) bin/x86_64

#-----------------------------------------------------------------------------

.PHONY : mac-arm
mac-arm:
	@echo
	@echo "----- building arm [SDK $(SDKVERSION)] -----"
#	@XFLAGS="-arch arm -mfpmath=sse" make clean all
	@HOMEBREW_PREFIX=/opt/homebrew XFLAGS="-target arm64-apple-macos$(MACOS_ARM64_TARGET)" $(MAKE) --no-print-directory clean
	@HOMEBREW_PREFIX=/opt/homebrew XFLAGS="-target arm64-apple-macos$(MACOS_ARM64_TARGET)" $(MAKE) --no-print-directory all
	@mkdir -p bin/arm
	@mv $(ALL_TOOLS) bin/arm

#-----------------------------------------------------------------------------

.PHONY : gen-mac-distrib
gen-mac-distrib:

	@printf "$(LOGFORMAT)" create "$(DISTRIB_PATH)" ""

	@rm -rf $(DISTRIB_PATH)
	@mkdir -p $(DISTRIB_PATH)/bin $(DISTRIB_PATH)/doc

	@cp -p $(DISTRIB_FILES) $(DISTRIB_PATH)
	@cp -p $(ALL_TOOLS) $(WDF_LINKS) $(DISTRIB_PATH)/bin
	@cp -p $(DOC_FILES) $(DISTRIB_PATH)/doc

	@chmod -R 755 $(DISTRIB_PATH)
	@chmod a+x $(DISTRIB_PATH)/*.sh $(DISTRIB_PATH)/bin/*
	@chmod -R a+X $(DISTRIB_PATH)

	@$(DISTRIB_PATH)/bin/wszst version -ll

	@tar -czf $(DISTRIB_PATH).tar.gz $(DISTRIB_PATH)
	@ln $(DISTRIB_PATH).tar.gz latest-mac.tar.gz
